# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Local reference/dependency jars (mods used only for compiling & study)
libs

# Planning docs kept out of the repo
roadmap.md

# Images dropped at the repository root while working — icons, screenshots for the readme, textures on
# their way somewhere else. Every one of them so far has been staged by accident and pushed. Only the
# root is ignored, so docs/ and the mod's own assets stay tracked.
/*.png
/*.jpg
/*.jpeg

# Private technical notes. docs/ itself stays tracked because the readme image lives there,
# so the document is ignored by name rather than the folder.
docs/PROJECT_STATE.md

# The readme rewritten as HTML, to paste into CurseForge's editor. Private for the same reason:
# it is a copy of what is already public, kept out of the repository so there is one readme, not two.
docs/CURSEFORGE_DESCRIPTION.html

docs/ANALISIS_1.1.0.md
